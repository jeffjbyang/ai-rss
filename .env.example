# Feishu group bot webhook. Keep the real value only on the server.
FEISHU_WEBHOOK_URL=""

# Optional LLM profile. Leave AI_RSS_LLM_MODEL empty to disable LLM enhancement.
AI_RSS_LLM_MODEL=""
AI_RSS_LLM_BASE_URL=""
AI_RSS_LLM_API_KEY=""

# Example: OpenAI-compatible cloud provider
# AI_RSS_LLM_MODEL="your-model"
# AI_RSS_LLM_BASE_URL="https://api.openai.com/v1"
# AI_RSS_LLM_API_KEY="your-api-key"

# Example: local OpenAI-compatible endpoint
# AI_RSS_LLM_MODEL="qwen2.5:7b"
# AI_RSS_LLM_BASE_URL="http://localhost:11434/v1"
# AI_RSS_LLM_API_KEY=""
